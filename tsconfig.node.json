{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    // DOM because tests/blocking-css.test.ts imports the stylesheet generator
    // out of src/, the same reason tsconfig.e2e.json carries it.
    "lib": ["ES2023", "DOM"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "manifest.config.ts",
    "tests"
  ]
}
