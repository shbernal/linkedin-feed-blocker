{
  "name": "linkedin-feed-blocker",
  "version": "0.3.1",
  "description": "Block LinkedIn's most distracting features.",
  "keywords": [
    "linkedin",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "zen-browser",
    "attention",
    "blocking",
    "productivity",
    "feed-control"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firefox": "EXT_TARGET=firefox pnpm run build",
    "package:chrome": "pnpm build && mkdir -p release && rm -f \"release/linkedin-feed-blocker-${npm_package_version}.zip\" && cd dist && zip -qr \"../release/linkedin-feed-blocker-${npm_package_version}.zip\" .",
    "package:firefox": "pnpm run build:firefox && web-ext build --source-dir dist-firefox --artifacts-dir release --filename linkedin-feed-blocker-firefox-{version}.zip --overwrite-dest",
    "package:source": "node scripts/package-source.mjs",
    "publish:amo": "node scripts/publish-amo.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev:chrome": "tsc -b && vite build && node scripts/open-chromium.mjs",
    "dev:firefox": "pnpm run build:firefox && node scripts/open-gecko.mjs",
    "dev:zen": "FIREFOX_BINARY=${FIREFOX_BINARY:-/usr/bin/zen-browser} pnpm run dev:firefox",
    "inspect:chrome": "tsc -b && vite build && node scripts/inspect-chromium.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:firefox": "pnpm run build:firefox && web-ext lint --source-dir dist-firefox",
    "validate:firefox": "pnpm run build:firefox && node scripts/validate-firefox.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsc -b && vite build && playwright test",
    "e2e:headed": "tsc -b && vite build && playwright test --headed",
    "e2e:ui": "tsc -b && vite build && playwright test --ui",
    "e2e:real:setup": "tsc -b && playwright test -c playwright.real.config.ts --grep @setup --headed",
    "e2e:real:login": "pnpm run e2e:real:setup",
    "e2e:real": "tsc -b && vite build && RUN_REAL_LINKEDIN_E2E=1 playwright test -c playwright.real.config.ts --grep-invert @setup --headed",
    "manual:linkedin": "tsc -b && vite build && playwright test -c playwright.manual.config.ts --headed",
    "media:snapshot": "node scripts/media-snapshot.mjs",
    "media:capture": "tsc -b && vite build && bash scripts/capture-media.sh capture",
    "media:encode": "bash scripts/capture-media.sh encode",
    "store:shots": "tsc -b && vite build && bash scripts/capture-media.sh store",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0"
  }
}
